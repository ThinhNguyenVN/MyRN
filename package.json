    "@react-navigation/bottom-tabs": "7.10.1",
    "@react-navigation/elements": "2.8.1",
    "@react-navigation/native": "7.1.28",
    "@reduxjs/toolkit": "2.11.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "axios": "1.13.6",
    "expo": "55.0.3",
    "expo-constants": "55.0.7",
    "expo-device": "55.0.9",
