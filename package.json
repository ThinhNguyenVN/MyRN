{
  "name": "my-rn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "dotenv -e .env.test -- expo start",
    "start:staging": "dotenv -e .env.staging -- expo start",
    "start:prod": "dotenv -e .env.production -- expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "branch:create": "node ./scripts/create-branch-name.js",
    "check:branch-name": "node ./scripts/check-branch-name.js",
    "test": "jest --runInBand",
    "lint": "eslint src",
    "fix": "eslint src --fix",
    "check:commit": "yarn lint && npx dotenv -e .env.test -- yarn test",
    "prepare": "husky",
    "postinstall": "mkdir public; cp $(node -p \"require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm', { paths: [require.resolve('@shopify/react-native-skia')] })\") public/canvaskit.wasm"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "5.2.8",
    "@gorhom/portal": "1.0.14",
    "@hookform/resolvers": "3.9.1",
    "@reduxjs/toolkit": "2.11.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "axios": "1.13.6",
    "expo": "57.0.9",
    "expo-constants": "57.0.8",
    "expo-device": "57.0.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-image": "57.0.1",
    "expo-linear-gradient": "57.0.1",
    "expo-linking": "57.0.4",
    "expo-localization": "57.0.1",
    "expo-router": "57.0.9",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-web-browser": "57.0.2",
    "i18next": "26.0.3",
    "lodash": "4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.54.2",
    "react-i18next": "17.0.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-reanimated-skeleton": "1.6.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "react-redux": "9.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.0",
    "@types/react": "19.2.10",
    "dotenv-cli": "11.0.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "57.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "msw": "2.12.14",
    "prettier": "3.7.4",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "react-native-worklets",
        "react-native-reanimated"
      ]
    }
  },
  "private": true
}
