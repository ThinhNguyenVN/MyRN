  "devDependencies": {
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.0",
    "@types/react": "19.2.10",
    "dotenv-cli": "11.0.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "55.0.0",
