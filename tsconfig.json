{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "paths": {
      "@root/*": ["./*"],
      "@/*": ["./src/*"],
      "@thinhnguyenvn/chat-core": ["./packages/chat-core/src"],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "packages/*/dist"]
}
